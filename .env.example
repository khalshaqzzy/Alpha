# Docker Compose environment variables (create at /opt/alpha/.env on each VM)

# ── Database ──────────────────────────────
DB_USER=alpha
DB_PASSWORD=change-me-to-a-strong-password

# ── Auth ──────────────────────────────────
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_EXPIRES_IN=7d

# ── Server ────────────────────────────────
NODE_ENV=production

# ── CORS ──────────────────────────────────
# Production VM:
CORS_ORIGIN=https://cryptoalpha.site,https://www.cryptoalpha.site
# Development VM:
# CORS_ORIGIN=https://dev.cryptoalpha.site
